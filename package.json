{
  "name": "frontend-pan-abuelo",
  "version": "1.0.0",
  "description": "Webpage for 'Pan para un Abuelo' foundation",
  "main": "index.js",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sass": "^1.93.2",
    "serve": "^14.2.5"
  },
  "scripts": {
    "clean": "rimraf dist && mkdir dist",
    "build:sass": "sass src/styles/main.scss dist/assets/css/main.css --no-source-map --style=compressed",
    "build:copy": "node src/scripts/lib/copy.js",
    "build": "npm run clean && npm run build:sass && npm run build:copy",
    "serve": "serve dist -p 4173"
  },
  "author": "Santiago Agudelo A",
  "license": "ISC"
}
